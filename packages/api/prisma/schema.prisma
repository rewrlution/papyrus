// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // https://github.com/prisma/prisma/issues/28573
  // safely ignore the error on the next line
  url      = env("DATABASE_URL")
}

// ============================================================================
// User Model
// ============================================================================
// Represents registered users in the system
// Table: users

model User {
  // Primary fields
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash") // bcrypt hash, which includes SALT
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Email verification fields
  // Email verification token is unique - industry practice to just use token
  // This prevents hackers from probing registered users
  verified           Boolean   @default(false)
  verificationToken  String?   @unique @map("verification_token")
  verificationExpiry DateTime? @map("verification_expiry")

  // Relations
  journals      Journal[] @relation("UserJournal")
  aiUsage       AiUsage[] @relation("UserAiUsage")
  aiTrialUsage  AiTrialUsage[] @relation("UserAiTrialUsage")
  aiPurchase    AiPurchase[] @relation("UserAiPurchases")

  // Indexes
  @@index([email]) // Login queries
  @@index([verificationToken]) // Email verification queries
  @@map("users")
}

// ============================================================================
// Journal Model
// ============================================================================
// Represents daily journal entries (one per user per day)
// All content is encrypted client-side using AES-256-GCM
// Table: journals

model Journal {
  // Primary fields
  id   String @id @default(cuid())
  date String // YYYYMMDD format

  // Encryption fields (AES-256-GCM)
  hash       String // SHA-256 hash of plaintext content (for change detection)
  ciphertext String // Encrypted journal content
  iv         String // Initialization vector (12 bytes, base64)
  authTag    String @map("auth_tag") // Authentication tag for integrity check (16 bytes, base64)

  // Timestamps
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at") // Soft delete timestamp

  // Relations
  userId String @map("user_id")
  user   User   @relation("UserJournal", fields: [userId], references: [id], onDelete: Cascade)

  // Constraints & Indexes
  @@unique([userId, date]) // One journal per day per user
  @@index([userId, date]) // Efficient queries for user's journals sorted by date
  @@index([userId, updatedAt]) // Efficient sync queries (get journals updated after timestamp)
  @@index([deletedAt]) // Filter out soft-deleted records efficiently
  @@map("journals")
}

// ============================================================================
// AI Usage Model
// ============================================================================
// Tracks AI feature usage per user per month
// Used for rate limiting and analytics
// Table: ai_usage

model AiUsage {
  // Primary fields
  id      String @id @default(cuid())
  userId  String @map("user_id")
  feature String // Feature name: 'standup'
  month   String // Month in 'YYYY-MM' format (e.g., '2026-01')
  count   Int    @default(0) // Number of times feature was used this month

  // Relations
  user   User   @relation("UserAiUsage", fields: [userId], references: [id], onDelete: Cascade)

  // Constraints & Indexes
  @@unique([userId, feature, month]) // One row per user/feature/month combination
  @@index([userId, feature, month]) // Fast lookups for rate limiting checks
  @@map("ai_usage")
}

// ============================================================================
// AI Triage Usage Model
// ============================================================================
// Tracks lifetime trial usage per user
// Table: ai_trial_usage
model AiTrialUsage {
  id      String  @id @default(cuid())
  userId  String  @map("user_id")
  feature String  // 'promotion'
  usedAt  DateTime  @default(now()) @map("used_at")

  // Relation to User
  user User @relation("UserAiTrialUsage", fields: [userId], references: [id], onDelete: Cascade)

  // Composite unique constraint (one row per user/feature)
  @@unique([userId, feature])

  @@map("ai_trial_usage")
}

// ============================================================================
// AiPurchase Model
// ============================================================================
// Tracks premium purchases
// Table: ai_purchase

model AiPurchase {
  id      String  @id @default(cuid())
  userId  String  @map("user_id")
  product String  // 'standup-pro' | 'promotion-pro' | 'interview-pro'

  // Purchase metadata
  purchasedAt DateTime  @default(now()) @map("purchased_at")
  expiresAt   DateTime? @map("expires_at") // When access expires

  // Payment metadata (optional, for Stripe integration later)
  amount    Int?    // Amount in cents (e.g., 900 for $9.00)
  currency  String? // 'usd', 'cad', 'eur', 'cny', etc.

  // Relation to User
  user User @relation("UserAiPurchases", fields: [userId], references: [id], onDelete: Cascade)

  // Indexes for fast queries
  @@index([userId, product])
  @@index([userId, product, expiresAt])

  @@map("ai_purchases")
}