# Server Configuration
NODE_ENV=development
PORT=3000

# Frontend URL (canonical app URL for email links, redirects, etc.)
# Development: http://localhost:5173
# Production: https://yourdomain.com
APP_URL=http://localhost:5173

# CORS Origins (comma-separated list of allowed origins)
# Development: http://localhost:3000,http://localhost:5173
# Production: https://yourdomain.com
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/papyrus

# Security: JWT secret (minimum 32 characters)
# generate with: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-long-change-this

# Security: Encryption key (exactly 64 hexadecimal characters)
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Email: Resend API (for transactional emails)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM=noreply@yourdomain.com

# Email: SMTP Configuration (alternative email provider)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
SMTP_FROM=noreply@yourdomain.com