{
  "name": "@rewrlution/papyrus-cli",
  "version": "0.0.3",
  "description": "AI-powered developer journaling CLI",
  "keywords": [
    "journal",
    "productivity"
  ],
  "license": "MIT",
  "author": "rewrlution@gmail.com",
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "bin": {
    "pp": "./dist/cli.js",
    "paper": "./dist/cli.js",
    "papyrus": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rimraf dist tsconfig.tsbuildinfo && tsc --build",
    "dev": "tsx watch src/cli.tsx",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "prepublishOnly": "npm run build && npm run test"
  },
  "dependencies": {
    "@rewrlution/papyrus-shared": "workspace:*",
    "axios": "^1.13.2",
    "chalk": "^5.6.2",
    "commander": "^14.0.2",
    "date-fns": "^4.1.0",
    "env-paths": "^3.0.0",
    "gray-matter": "^4.0.3",
    "ink": "^6.6.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "jwt-decode": "^4.0.0",
    "react": "^19.2.3"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "tsx": "^4.21.0"
  }
