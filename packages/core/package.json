{
  "name": "@rewrlution/papyrus-core",
  "version": "0.1.0",
  "description": "Core filesystem logic for the Papyrus plugin ecosystem",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./paths": {
      "import": "./dist/paths.js",
      "types": "./dist/paths.d.ts"
    },
    "./journal": {
      "import": "./dist/journal.js",
      "types": "./dist/journal.d.ts"
    },
    "./profile": {
      "import": "./dist/profile.js",
      "types": "./dist/profile.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "env-paths": "^3.0.0",
    "gray-matter": "^4.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
