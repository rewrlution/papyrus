{
  "name": "papyrus",
  "version": "1.0.0",
  "private": true,
  "description": "Papyrus monorepo",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">= 18.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "clean": "turbo run clean && rimraf node_modules"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rewrlution/papyrus.git"
  },
  "devDependencies": {
    "rimraf": "^6.1.2",
    "turbo": "^2.3.3"
  },
  "packageManager": "pnpm@9.14.4",
  "author": "rewrlution@gmail.com"
}
